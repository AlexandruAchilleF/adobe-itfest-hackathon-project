# Copiază fișierul în `.env` și completează ce ai. NIMIC nu e obligatoriu:
# fără chei, aplicația merge în „mod demo" (AI simulat, multiplayer local între tab-uri).

# Numele produsului (apare în meniu)
VITE_APP_NAME=
# Mascota: nume și culoare (implicit „Țepi”, ariciul maro). Schimbați-le după produs.
VITE_MASCOT_NAME=
VITE_MASCOT_COLOR=

# ── AI (server-side, NU pune prefix VITE_ — cheile nu ajung în browser) ──
# Furnizorul ales: gemini | anthropic | mock. Gol = primul care are cheie, altfel mock.
AI_PROVIDER=
# Gemini (are free tier cu limite): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low = răspuns rapid pentru demo-uri live; urcă la medium/high pentru sarcini grele
ANTHROPIC_EFFORT=low

# Geocodare (adresă → coordonate) prin OpenStreetMap Nominatim; puneți un nume de aplicație propriu
GEOCODER_USER_AGENT=hackathon-template-itfest/1.0

# ── Date persistente, sondaj live și share prin QR (client-side, cheia publică/publishable e ok în browser) ──
# https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Bucket public în Supabase Storage pentru link-urile din QR (creează-l cu numele de mai jos)
VITE_SUPABASE_SHARE_BUCKET=shares

# ── Adobe PDF Embed API (gratuit): https://acrobatservices.adobe.com/dc-integration-creation-app-cdn/main.html
# Creează credențiale pentru domeniul `localhost` (dev) și separat pentru domeniul de deploy.
VITE_ADOBE_PDF_CLIENT_ID=

# ── Notificări (server-side). Fără ele, /api/notify e simulat și UI-ul arată „simulat”. ──
# SMS prin Twilio (contul de test trimite doar spre numere verificate în consola Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email prin Resend
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Scenariul activ (vezi src/scenario/config.ts): deconturi | sesizari | resurse | vecini. Gol = implicitul din config.
VITE_SCENARIO=
